PORT=9001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/blog_db

# JWT Secrets - Replace with strong, randomly generated secrets in production
JWT_ACCESS_SECRET=super_secret_access_jwt_key_blog_2026_dev_mode
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_blog_2026_dev_mode
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# Admin Registration Secret Key (used to register admin users)
ADMIN_SECRET_KEY=super_secret_admin_key_for_blog_2026

